    {
      "id": 5,
      "references": [
        4,
        0,
        2
      ],
      "type": "trigger",
      "data": {
        "on": 4,
        "references_in_body": [
          4,
          0,
          2
        ],
        "name": "check_week_insert",
        "sql": "CREATE TRIGGER check_week_insert BEFORE INSERT ON schedule_weeks BEGIN\r\n  SELECT CASE WHEN NEW.active_week > (SELECT s.total_weeks FROM semesters s\r\n    JOIN course_schedules c ON c.semester_id = s.id WHERE c.id = NEW.schedule_id)\r\n    THEN RAISE(ABORT, 'Active week exceeds semester') END;\r\nEND;"
      }
    },
    {
      "id": 6,
      "references": [
        4,
        0,
        2
      ],
      "type": "trigger",
      "data": {
        "on": 4,
        "references_in_body": [
          4,
          0,
          2
        ],
        "name": "check_week_update",
        "sql": "CREATE TRIGGER check_week_update BEFORE UPDATE ON schedule_weeks BEGIN\r\n  SELECT CASE WHEN NEW.active_week > (SELECT s.total_weeks FROM semesters s\r\n    JOIN course_schedules c ON c.semester_id = s.id WHERE c.id = NEW.schedule_id)\r\n    THEN RAISE(ABORT, 'Active week exceeds semester') END;\r\nEND;"
      }
    },
    {
      "id": 7,
      "references": [
        0,
        4,
        2
      ],
      "type": "trigger",
      "data": {
        "on": 0,
        "references_in_body": [
          0,
          4,
          2
        ],
        "name": "check_semester_shrink",
        "sql": "CREATE TRIGGER check_semester_shrink BEFORE UPDATE OF total_weeks ON semesters BEGIN\r\n  SELECT CASE WHEN EXISTS (SELECT 1 FROM schedule_weeks w JOIN course_schedules c\r\n    ON c.id = w.schedule_id WHERE c.semester_id = NEW.id AND w.active_week > NEW.total_weeks)\r\n    THEN RAISE(ABORT, 'Existing active weeks exceed new semester') END;\r\nEND;"
      }
    },
