  "fixed_sql": [
    {
      "name": "semesters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"semesters\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0 AND name <> 'unclear'), \"start_date\" TEXT NOT NULL CHECK (length(start_date) = 10 AND COALESCE(date(start_date, '+0 days') = start_date, 0)), \"end_date\" TEXT NOT NULL CHECK (length(end_date) = 10 AND COALESCE(date(end_date, '+0 days') = end_date, 0)), \"total_weeks\" INTEGER NOT NULL CHECK (total_weeks BETWEEN 1 AND 366), \"week_start_day\" INTEGER NOT NULL CHECK (week_start_day BETWEEN 1 AND 7), \"manual_week_offset\" INTEGER NOT NULL DEFAULT 0, CHECK(end_date >= start_date));"
        }
      ]
    },
    {
      "name": "courses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"courses\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL CHECK (length(trim(name)) > 0 AND name <> 'unclear'), \"teacher\" TEXT NOT NULL, \"color\" TEXT NOT NULL DEFAULT 'default', \"remark\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "course_schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"course_schedules\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"course_id\" TEXT NOT NULL REFERENCES courses(id), \"semester_id\" TEXT NOT NULL REFERENCES semesters(id), \"weekday\" INTEGER NOT NULL CHECK (weekday BETWEEN 1 AND 7), \"start_section\" INTEGER NOT NULL CHECK (start_section >= 1), \"end_section\" INTEGER NOT NULL CHECK (end_section >= start_section), \"classroom\" TEXT NOT NULL, \"remark\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "schedules_semester_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX schedules_semester_day ON course_schedules (semester_id, weekday, start_section)"
        }
      ]
    },
    {
      "name": "schedule_weeks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"schedule_weeks\" (\"schedule_id\" TEXT NOT NULL REFERENCES course_schedules(id)ON DELETE CASCADE, \"active_week\" INTEGER NOT NULL CHECK (active_week >= 1), PRIMARY KEY(schedule_id, active_week));"
        }
      ]
    },
    {
      "name": "check_week_insert",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER check_week_insert BEFORE INSERT ON schedule_weeks BEGIN SELECT CASE WHEN NEW.active_week > (SELECT s.total_weeks FROM semesters AS s JOIN course_schedules AS c ON c.semester_id = s.id WHERE c.id = NEW.schedule_id) THEN RAISE (ABORT, 'Active week exceeds semester') END;END"
        }
      ]
    },
    {
      "name": "check_week_update",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER check_week_update BEFORE UPDATE ON schedule_weeks BEGIN SELECT CASE WHEN NEW.active_week > (SELECT s.total_weeks FROM semesters AS s JOIN course_schedules AS c ON c.semester_id = s.id WHERE c.id = NEW.schedule_id) THEN RAISE (ABORT, 'Active week exceeds semester') END;END"
        }
      ]
    },
    {
      "name": "check_semester_shrink",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER check_semester_shrink BEFORE UPDATE OF total_weeks ON semesters BEGIN SELECT CASE WHEN EXISTS (SELECT 1 FROM schedule_weeks AS w JOIN course_schedules AS c ON c.id = w.schedule_id WHERE c.semester_id = NEW.id AND w.active_week > NEW.total_weeks) THEN RAISE (ABORT, 'Existing active weeks exceed new semester') END;END"
        }
      ]
    },
    {
      "name": "class_times",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"class_times\" (\"semester_id\" TEXT NOT NULL REFERENCES semesters(id), \"section\" INTEGER NOT NULL CHECK (section >= 1), \"start_time\" TEXT NOT NULL CHECK (start_time GLOB '[0-2][0-9]:[0-5][0-9]' AND start_time < '24:00'), \"end_time\" TEXT NOT NULL CHECK (end_time GLOB '[0-2][0-9]:[0-5][0-9]' AND end_time < '24:00'), PRIMARY KEY(semester_id, section), CHECK(end_time > start_time));"
        }
      ]
    },
    {
      "name": "task_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_events\" (\"id\" TEXT NOT NULL PRIMARY KEY CHECK (length(trim(id)) > 0), \"title\" TEXT NOT NULL CHECK (length(trim(title)) > 0), \"event_date\" TEXT NOT NULL CHECK (length(event_date) = 10 AND COALESCE(date(event_date, '+0 days') = event_date, 0)), \"start_time\" TEXT NOT NULL CHECK (start_time GLOB '[0-2][0-9]:[0-5][0-9]' AND start_time < '24:00'), \"end_time\" TEXT NOT NULL CHECK (end_time GLOB '[0-2][0-9]:[0-5][0-9]' AND end_time < '24:00'), \"description\" TEXT NOT NULL DEFAULT '', \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1)), \"reminder_minutes\" INTEGER CHECK (reminder_minutes >= 0), \"repeat_rule\" TEXT CHECK (repeat_rule IS NULL), CHECK(end_time > start_time));"
        }
      ]
    },
    {
      "name": "tasks_date_time",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX tasks_date_time ON task_events (event_date, start_time)"
        }
      ]
    },
    {
      "name": "import_drafts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_drafts\" (\"source_hash\" TEXT NOT NULL PRIMARY KEY, \"current_revision\" INTEGER NOT NULL CHECK (current_revision >= 1), \"original_json\" TEXT NOT NULL CHECK (json_valid(original_json)));"
        }
      ]
    },
    {
      "name": "import_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_revisions\" (\"source_hash\" TEXT NOT NULL REFERENCES import_drafts(source_hash), \"revision\" INTEGER NOT NULL CHECK (revision >= 1), \"reviewed_json\" TEXT NOT NULL CHECK (json_valid(reviewed_json)), \"exclusions_json\" TEXT NOT NULL CHECK (json_valid(exclusions_json)), \"reason\" TEXT NOT NULL, PRIMARY KEY(source_hash, revision));"
        }
      ]
    },
    {
      "name": "import_commits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_commits\" (\"source_hash\" TEXT NOT NULL PRIMARY KEY, \"revision\" INTEGER NOT NULL, \"semester_id\" TEXT NOT NULL UNIQUE REFERENCES semesters(id), \"course_count\" INTEGER NOT NULL, \"schedule_count\" INTEGER NOT NULL, FOREIGN KEY(source_hash, revision)REFERENCES import_revisions(source_hash, revision));"
        }
      ]
    },
    {
      "name": "import_record_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_record_metadata\" (\"schedule_id\" TEXT NOT NULL PRIMARY KEY REFERENCES course_schedules(id), \"source_hash\" TEXT NOT NULL, \"draft_revision\" INTEGER NOT NULL, \"record_id\" TEXT NOT NULL, \"teaching_class\" TEXT NOT NULL, \"total_hours\" INTEGER, \"credits\" INTEGER, \"source_json\" TEXT NOT NULL CHECK (json_valid(source_json)), FOREIGN KEY(source_hash, draft_revision)REFERENCES import_revisions(source_hash, revision));"
        }
      ]
    },
    {
      "name": "class_days_off",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"class_days_off\" (\"semester_id\" TEXT NOT NULL REFERENCES semesters(id)ON DELETE CASCADE, \"day\" TEXT NOT NULL CHECK (length(day) = 10 AND COALESCE(date(day, '+0 days') = day, 0)), \"reason\" TEXT NOT NULL CHECK (length(trim(reason)) > 0), PRIMARY KEY(semester_id, day));"
        }
      ]
    },
    {
      "name": "class_day_replacements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"class_day_replacements\" (\"semester_id\" TEXT NOT NULL REFERENCES semesters(id)ON DELETE CASCADE, \"target_day\" TEXT NOT NULL CHECK (length(target_day) = 10 AND date(target_day) = target_day), \"source_day\" TEXT NOT NULL CHECK (length(source_day) = 10 AND date(source_day) = source_day), PRIMARY KEY(semester_id, target_day), CHECK(source_day <> target_day));"
        }
      ]
    },
    {
      "name": "lesson_transfers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_transfers\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"semester_id\" TEXT NOT NULL REFERENCES semesters(id)ON DELETE CASCADE, \"schedule_id\" TEXT NOT NULL REFERENCES course_schedules(id)ON DELETE CASCADE, \"source_day\" TEXT NOT NULL, \"target_day\" TEXT NOT NULL, \"source_start\" INTEGER NOT NULL CHECK (source_start > 0), \"source_end\" INTEGER NOT NULL CHECK (source_end >= source_start), \"target_start\" INTEGER NOT NULL CHECK (target_start > 0), \"keep_source\" INTEGER NOT NULL CHECK (keep_source IN (0, 1)));"
        }
      ]
    }
